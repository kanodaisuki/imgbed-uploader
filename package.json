{
  "name": "imgbed-uploader",
  "displayName": "ImgBed Uploader",
  "publisher": "KanoChan",
  "description": "%extension.description%",
  "icon": "images/icon.png",
  "keywords": [
    "markdown",
    "mdx",
    "image",
    "upload",
    "imgbed",
    "cloudflare",
    "图床",
    "图片上传"
  ],
  "version": "1.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kanodaisuki/imgbed-uploader"
  },
  "engines": {
    "vscode": "^1.146.0"
  },
  "packageManager": "pnpm@12.4.1",
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%workspaceTrust.description%",
      "restrictedConfigurations": [
        "imgbedUploader.serverUrl",
        "imgbedUploader.authType",
        "imgbedUploader.uploadChannel",
        "imgbedUploader.channelName",
        "imgbedUploader.uploadFolder",
        "imgbedUploader.expire",
        "imgbedUploader.customCdn",
        "imgbedUploader.uploadRemoteImages",
        "imgbedUploader.remoteWhitelist"
      ]
    }
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "configuration": {
      "title": "ImgBed Uploader",
      "properties": {
        "imgbedUploader.serverUrl": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%config.imgbedUploader.serverUrl.description%"
        },
        "imgbedUploader.authType": {
          "type": "string",
          "enum": [
            "authCode",
            "apiToken",
            "none"
          ],
          "default": "authCode",
          "scope": "resource",
          "description": "%config.imgbedUploader.authType.description%"
        },
        "imgbedUploader.uploadChannel": {
          "type": "string",
          "enum": [
            "telegram",
            "cfr2",
            "s3",
            "discord",
            "huggingface",
            "webdav"
          ],
          "default": "telegram",
          "scope": "resource",
          "description": "%config.imgbedUploader.uploadChannel.description%"
        },
        "imgbedUploader.channelName": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%config.imgbedUploader.channelName.description%"
        },
        "imgbedUploader.uploadFolder": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%config.imgbedUploader.uploadFolder.description%"
        },
        "imgbedUploader.uploadNameType": {
          "type": "string",
          "enum": [
            "default",
            "index",
            "origin",
            "short"
          ],
          "default": "default",
          "scope": "resource",
          "description": "%config.imgbedUploader.uploadNameType.description%"
        },
        "imgbedUploader.expire": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%config.imgbedUploader.expire.description%"
        },
        "imgbedUploader.serverCompress": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%config.imgbedUploader.serverCompress.description%"
        },
        "imgbedUploader.autoRetry": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%config.imgbedUploader.autoRetry.description%"
        },
        "imgbedUploader.customCdn": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%config.imgbedUploader.customCdn.description%"
        },
        "imgbedUploader.uploadRemoteImages": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "%config.imgbedUploader.uploadRemoteImages.description%"
        },
        "imgbedUploader.remoteWhitelist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "%config.imgbedUploader.remoteWhitelist.description%"
        },
        "imgbedUploader.pasteUpload": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%config.imgbedUploader.pasteUpload.description%"
        }
      }
    },
    "commands": [
      {
        "command": "imgbed-uploader.uploadAll",
        "title": "%cmd.uploadAll%",
        "category": "ImgBed Uploader",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "imgbed-uploader.uploadSelected",
        "title": "%cmd.uploadSelected%",
        "category": "ImgBed Uploader"
      },
      {
        "command": "imgbed-uploader.uploadFile",
        "title": "%cmd.uploadLocal%",
        "category": "ImgBed Uploader"
      },
      {
        "command": "imgbed-uploader.setCredentials",
        "title": "%cmd.setCredentials%",
        "category": "ImgBed Uploader"
      },
      {
        "command": "imgbed-uploader.testConnection",
        "title": "%cmd.testConnection%",
        "category": "ImgBed Uploader"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "imgbed-uploader.uploadAll",
          "when": "editorLangId == markdown || editorLangId == mdx",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "imgbed-uploader.uploadAll",
          "when": "editorLangId == markdown || editorLangId == mdx",
          "group": "imgbed@1"
        },
        {
          "command": "imgbed-uploader.uploadSelected",
          "when": "editorHasSelection && (editorLangId == markdown || editorLangId == mdx)",
          "group": "imgbed@2"
        }
      ],
      "explorer/context": [
        {
          "command": "imgbed-uploader.uploadFile",
          "when": "resourceExtname =~ /\\.(png|jpe?g|gif|webp|avif|svg|bmp|ico)$/i",
          "group": "imgbed@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "vsix": "vsce package --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile",
    "check-types": "tsc --noEmit && tsc -p tsconfig.strict.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vscode-test",
    "test:zh": "vscode-test --config .vscode-test.zh.mjs",
    "prepare": "husky",
    "l10n:extract": "vscode-l10n-dev export --outDir ./l10n ./src"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.146.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "npm-run-all": "^4.1.5",
    "ovsx": "^1.4.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
